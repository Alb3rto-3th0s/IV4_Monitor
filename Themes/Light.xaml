<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme: white background. Status colors (pills, position bar) keep white text. -->
    <SolidColorBrush x:Key="BgBrush" Color="#EEF1F5"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#CDD4DD"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1A1F26"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#5F6B78"/>
    <SolidColorBrush x:Key="ButtonBrush" Color="#E4E8EE"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#D3D9E1"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0F5FD6"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#B3261E"/>
    <SolidColorBrush x:Key="OkBrush" Color="#1E8E4E"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#C98A00"/>
    <SolidColorBrush x:Key="BadBrush" Color="#C62828"/>
    <SolidColorBrush x:Key="IdleBrush" Color="#6B7682"/>
    <SolidColorBrush x:Key="ArrowIdleBrush" Color="#8C96A2"/>
</ResourceDictionary>
