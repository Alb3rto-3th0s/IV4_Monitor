<Window x:Class="VisorIV4.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S_AdminTitle}" Width="1400" Height="900" MinWidth="1100" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        </Style>
        <Style x:Key="SmallLbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Bottom buttons -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource FlatButton}" Content="{DynamicResource S_ExitApp}" Background="{DynamicResource DangerBrush}" Foreground="White" Click="OnExitApp"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource FlatButton}" Content="{DynamicResource S_Cancel}" IsCancel="True"/>
                    <Button Style="{StaticResource FlatButton}" Content="{DynamicResource S_Save}" Background="{DynamicResource AccentBrush}" Foreground="White" Click="OnSave"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="640"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ======= Settings ======= -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">

                    <!-- Cameras -->
                    <TextBlock Style="{StaticResource Section}" Text="{DynamicResource S_SecCameras}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Lbl}" Text="{DynamicResource S_ActiveCam}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                        <ComboBox x:Name="ActiveCameraCombo" Grid.Column="1" DisplayMemberPath="Display" FontWeight="SemiBold"/>
                    </Grid>
                    <TextBlock Text="{DynamicResource S_CamsNote}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                    <ItemsControl x:Name="CamerasList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,6" Padding="8,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Grid.RowSpan="4" Text="{Binding Number}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1" Style="{StaticResource SmallLbl}" Text="{DynamicResource S_CamName}"/>
                                        <TextBlock Grid.Column="3" Style="{StaticResource SmallLbl}" Text="{DynamicResource S_CamUrl}"/>
                                        <TextBlock Grid.Column="5" Style="{StaticResource SmallLbl}" Text="{DynamicResource S_ViewerMode}"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"/>
                                        <ComboBox Grid.Row="1" Grid.Column="5" SelectedValuePath="Tag" SelectedValue="{Binding ViewerMode}">
                                            <ComboBoxItem Content="{DynamicResource S_ModeImage}" Tag="Image"/>
                                            <ComboBoxItem Content="{DynamicResource S_ModeWeb}" Tag="Web"/>
                                        </ComboBox>

                                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource SmallLbl}" Text="{DynamicResource S_ProgTag}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource SmallLbl}" Text="{DynamicResource S_XTag}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="5" Style="{StaticResource SmallLbl}" Text="{DynamicResource S_YTag}"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ProgramTag, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding OffsetXTag, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Row="3" Grid.Column="5" Text="{Binding OffsetYTag, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Web viewer -->
                    <TextBlock Style="{StaticResource Section}" Text="{DynamicResource S_SecCamera}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Lbl}" Grid.Row="4" Text="{DynamicResource S_GhostStyle}"/>
                        <ComboBox x:Name="GhostStyleCombo" Grid.Row="4" Grid.Column="1" SelectedValuePath="Tag">
                            <ComboBoxItem Tag="Watermark" Content="{DynamicResource S_GhostWatermark}"/>
                            <ComboBoxItem Tag="Image" Content="{DynamicResource S_GhostImage}"/>
                            <ComboBoxItem Tag="Outline" Content="{DynamicResource S_GhostOutline}"/>
                        </ComboBox>
                        <TextBlock Style="{StaticResource Lbl}" Grid.Row="3" Text="{DynamicResource S_GhostOpacity}" ToolTip="{DynamicResource S_GhostTip}"/>
                        <TextBox x:Name="GhostOpacityBox" Grid.Row="3" Grid.Column="1" ToolTip="{DynamicResource S_GhostTip}"/>
                        <TextBlock Style="{StaticResource Lbl}" Text="{DynamicResource S_ImgInterval}" ToolTip="{DynamicResource S_ImgIntervalTip}"/>
                        <TextBox x:Name="ImgIntervalBox" Grid.Column="1" ToolTip="{DynamicResource S_ImgIntervalTip}"/>
                        <TextBlock Style="{StaticResource Lbl}" Grid.Row="1" Text="{DynamicResource S_Zoom}"/>
                        <TextBox x:Name="CameraZoomBox" Grid.Row="1" Grid.Column="1"/>
                        <TextBlock Style="{StaticResource Lbl}" Grid.Row="2" Text="{DynamicResource S_ReloadEvery}" ToolTip="{DynamicResource S_ZeroNever}"/>
                        <TextBox x:Name="ReloadBox" Grid.Row="2" Grid.Column="1" ToolTip="{DynamicResource S_ZeroNever}"/>
                    </Grid>

                    <!-- Display -->
                    <TextBlock Style="{StaticResource Section}" Text="{DynamicResource S_SecDisplay}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Lbl}" Grid.Row="4" Text="{DynamicResource S_Theme}"/>
                        <ComboBox x:Name="ThemeCombo" Grid.Row="4" Grid.Column="1" SelectedValuePath="Tag">
                            <ComboBoxItem Tag="Dark" Content="{DynamicResource S_ThemeDark}"/>
                            <ComboBoxItem Tag="Light" Content="{DynamicResource S_ThemeLight}"/>
                        </ComboBox>
                        <TextBlock Style="{StaticResource Lbl}" Text="{DynamicResource S_Language}"/>
                        <ComboBox x:Name="LanguageCombo" Grid.Column="1" SelectionChanged="OnLanguagePreview">
                            <ComboBoxItem Content="English" Tag="en"/>
                            <ComboBoxItem Content="Español" Tag="es"/>
                        </ComboBox>
                        <TextBlock Style="{StaticResource Lbl}" Grid.Row="1" Text="{DynamicResource S_Layout}"/>
                        <ComboBox x:Name="LayoutCombo" Grid.Row="1" Grid.Column="1">
                            <ComboBoxItem Content="{DynamicResource S_LayoutH}" Tag="Horizontal"/>
                            <ComboBoxItem Content="{DynamicResource S_LayoutV}" Tag="Vertical"/>
                        </ComboBox>
                        <TextBlock Style="{StaticResource Lbl}" Grid.Row="2" Text="{DynamicResource S_RefPct}"/>
                        <TextBox x:Name="RatioBox" Grid.Row="2" Grid.Column="1" ToolTip="20 – 80"/>
                        <TextBlock Style="{StaticResource Lbl}" Grid.Row="3" Text="{DynamicResource S_NewPwd}"/>
                        <PasswordBox x:Name="NewPwdBox" Grid.Row="3" Grid.Column="1" Margin="0,3" Padding="4,3" ToolTip="{DynamicResource S_NewPwdTip}"/>
                    </Grid>
                    <CheckBox x:Name="RefFirstCheck" Content="{DynamicResource S_RefFirst}"/>
                    <CheckBox x:Name="KioskCheck" Content="{DynamicResource S_Kiosk}"/>

                    <!-- PLC -->
                    <TextBlock Style="{StaticResource Section}" Text="{DynamicResource S_SecPlc}"/>
                    <CheckBox x:Name="PlcEnabledCheck" Content="{DynamicResource S_PlcEnable}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Lbl}" Text="{DynamicResource S_PlcIp}"/>
                        <TextBox x:Name="PlcIpBox" Grid.Column="1"/>
                        <TextBlock Style="{StaticResource Lbl}" Grid.Row="1" Text="{DynamicResource S_PlcType}"/>
                        <ComboBox x:Name="PlcTypeCombo" Grid.Row="1" Grid.Column="1"/>
                        <TextBlock Style="{StaticResource Lbl}" Grid.Row="2" Text="{DynamicResource S_PlcPath}"/>
                        <TextBox x:Name="PlcPathBox" Grid.Row="2" Grid.Column="1" ToolTip="{DynamicResource S_PlcPathTip}"/>
                        <TextBlock Style="{StaticResource Lbl}" Grid.Row="3" Text="{DynamicResource S_ProgType}"/>
                        <ComboBox x:Name="ProgTypeCombo" Grid.Row="3" Grid.Column="1"/>
                        <TextBlock Style="{StaticResource Lbl}" Grid.Row="4" Text="{DynamicResource S_ProgOffset}"/>
                        <TextBox x:Name="ProgOffsetBox" Grid.Row="4" Grid.Column="1" ToolTip="{DynamicResource S_ProgOffsetTip}"/>
                        <TextBlock Style="{StaticResource Lbl}" Grid.Row="5" Text="{DynamicResource S_Poll}"/>
                        <TextBox x:Name="PollBox" Grid.Row="5" Grid.Column="1"/>
                    </Grid>

                    <CheckBox x:Name="ReadOffsetsCheck" Content="{DynamicResource S_ReadOffsets}" Margin="0,12,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Lbl}" Text="{DynamicResource S_XYType}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ComboBox x:Name="XTypeCombo" Width="110"/>
                            <ComboBox x:Name="YTypeCombo" Width="110" Margin="8,3"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Lbl}" Grid.Row="1" Text="{DynamicResource S_Tol}"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="TolXBox" Width="110"/>
                            <TextBox x:Name="TolYBox" Width="110" Margin="8,3"/>
                            <TextBox x:Name="UnitsBox" Width="60" ToolTip="{DynamicResource S_Units}"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="InvXCheck" Content="{DynamicResource S_InvX}"/>
                    <CheckBox x:Name="InvYCheck" Content="{DynamicResource S_InvY}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ======= Reference images per program ======= -->
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource Section}" Text="{DynamicResource S_SecRefs}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Lbl}" Text="{DynamicResource S_RefCam}"/>
                        <ComboBox x:Name="RefCameraCombo" Width="260" DisplayMemberPath="Display" SelectionChanged="OnRefCameraChanged"/>
                    </StackPanel>
                    <TextBlock x:Name="RefFolderText" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,8" TextWrapping="Wrap"
                               Text="{DynamicResource S_RefNote}"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="RefList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,8,6" Padding="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding NumberText}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="Black" Height="72" Margin="0,0,12,0">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                                <TextBlock Text="{DynamicResource S_NoImage}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding MissingVisibility}"/>
                                            </Grid>
                                        </Border>
                                        <TextBox Grid.Column="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" ToolTip="{DynamicResource S_NameTip}"/>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <Button Style="{StaticResource FlatButton}" Content="{DynamicResource S_LoadImg}" Tag="{Binding}" Click="OnLoadImage"/>
                                            <Button Style="{StaticResource FlatButton}" Content="{DynamicResource S_Remove}" Tag="{Binding}" Click="OnRemoveImage"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
