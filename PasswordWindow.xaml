<Window x:Class="VisorIV4.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S_Admin}" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
    <StackPanel Margin="24" Width="320">
        <TextBlock Text="{DynamicResource S_PwdPrompt}" FontSize="16" FontWeight="SemiBold"/>
        <PasswordBox x:Name="Pwd" Margin="0,12,0,4" FontSize="18" Padding="6" KeyDown="OnKey"/>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource BadBrush}" FontSize="13" Visibility="Collapsed" Text="{DynamicResource S_PwdWrong}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource FlatButton}" Content="{DynamicResource S_Cancel}" IsCancel="True"/>
            <Button Style="{StaticResource FlatButton}" Content="{DynamicResource S_Enter}" IsDefault="True" Background="{DynamicResource AccentBrush}" Foreground="White" Click="OnOk"/>
        </StackPanel>
    </StackPanel>
</Window>
